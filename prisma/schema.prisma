datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  GUEST
  CUSTOMER
  VERIFIED_COMPANION
  ADMIN
  SUPER_ADMIN
  MODERATOR
  SUPPORT_TEAM
  VERIFICATION_TEAM
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentType {
  GOVERNMENT_ID
  PASSPORT
  DRIVING_LICENSE
  SELFIE_LIVE
  ADDRESS_PROOF
  BANK_VERIFICATION
  POLICE_CLEARANCE
}

enum BookingStatus {
  PENDING_APPROVAL
  ACCEPTED
  REJECTED
  ESCROW_LOCKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  STRIPE
  RAZORPAY
  WALLET
  UPI
  CREDIT_CARD
}

enum EscrowStatus {
  HELD
  RELEASED_TO_COMPANION
  REFUNDED_TO_USER
  PARTIAL_REFUND
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                String               @id @default(uuid())
  email             String               @unique
  phone             String?              @unique
  passwordHash      String
  fullName          String
  role              RoleType             @default(CUSTOMER)
  isEmailVerified   Boolean              @default(false)
  isPhoneVerified   Boolean              @default(false)
  is2FAEnabled      Boolean              @default(false)
  twoFASecret       String?
  avatar            String?
  accountFrozen     Boolean              @default(false)
  riskScore         Float                @default(0.0)
  riskLevel         RiskLevel            @default(LOW)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // Relationships
  profile           CompanionProfile?
  kycDocuments      VerificationDocument[]
  bookingsAsUser    Booking[]            @relation("UserBookings")
  bookingsAsCompanion Booking[]          @relation("CompanionBookings")
  wallet            Wallet?
  reviewsWritten    Review[]             @relation("ReviewAuthor")
  reviewsReceived   Review[]             @relation("ReviewTarget")
  sentMessages      ChatMessage[]        @relation("SentMessages")
  receivedMessages  ChatMessage[]        @relation("ReceivedMessages")
  emergencyContacts EmergencyContact[]
  sosAlerts         PanicAlert[]
  reportsFiled      IncidentReport[]     @relation("Reporter")
  reportsAgainst    IncidentReport[]     @relation("ReportedUser")
  auditLogs         AuditLog[]
  sessions          UserSession[]

  @@index([email, phone])
}

model CompanionProfile {
  id                String               @id @default(uuid())
  userId            String               @unique
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bio               String
  age               Int
  gender            String
  city              String
  country           String
  latitude          Float?
  longitude         Float?
  
  languages         String[]
  skills            String[]
  categories        String[]             // e.g. Event Companion, Shopping, Travel, Study, Elderly Support
  photos            String[]
  
  hourlyRate        Float
  dailyRate         Float?
  weeklyRate        Float?
  monthlyRate       Float?
  
  availability      Json                 // Time slot JSON matrix
  isAvailableNow    Boolean              @default(true)
  verificationBadge Boolean              @default(false)
  
  ratingAvg         Float                @default(5.0)
  ratingCount       Int                  @default(0)
  completedBookings Int                  @default(0)
  responseTimeMin   Int                  @default(15)
  
  education         String?
  experienceYears   Int                  @default(1)
  
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([city, ratingAvg])
}

model VerificationDocument {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              DocumentType
  documentUrl       String
  selfieMatchScore  Float?
  status            VerificationStatus   @default(PENDING)
  rejectionReason   String?
  verifiedByUserId  String?
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId, status])
}

model Booking {
  id                String               @id @default(uuid())
  bookingNumber     String               @unique @default(cuid())
  userId            String
  user              User                 @relation("UserBookings", fields: [userId], references: [id])
  companionId       String
  companion         User                 @relation("CompanionBookings", fields: [companionId], references: [id])
  
  category          String
  startTime         DateTime
  endTime           DateTime
  durationHours     Float
  locationAddress   String
  specialNotes      String?
  
  hourlyRate        Float
  baseAmount        Float
  escrowFee         Float
  platformFee       Float
  totalAmount       Float
  
  status            BookingStatus        @default(PENDING_APPROVAL)
  isInstantBooking  Boolean              @default(false)
  
  payment           Payment?
  review            Review?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId, companionId, status])
}

model Wallet {
  id                String               @id @default(uuid())
  userId            String               @unique
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance           Float                @default(0.0)
  escrowBalance     Float                @default(0.0)
  currency          String               @default("USD")
  transactions      Transaction[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model Transaction {
  id                String               @id @default(uuid())
  walletId          String
  wallet            Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount            Float
  type              String               // DEPOSIT, WITHDRAWAL, ESCROW_HOLD, ESCROW_RELEASE, REFUND
  referenceId       String?
  description       String
  status            String               @default("SUCCESS")
  createdAt         DateTime             @default(now())
}

model Payment {
  id                String               @id @default(uuid())
  bookingId         String               @unique
  booking           Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider          PaymentMethod
  transactionRef    String               @unique
  amount            Float
  currency          String               @default("USD")
  escrowStatus      EscrowStatus         @default(HELD)
  payoutDate        DateTime?
  createdAt         DateTime             @default(now())
}

model Review {
  id                String               @id @default(uuid())
  bookingId         String               @unique
  booking           Booking              @relation(fields: [bookingId], references: [id])
  authorId          String
  author            User                 @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId          String
  target            User                 @relation("ReviewTarget", fields: [targetId], references: [id])
  
  rating            Int
  comment           String
  photos            String[]
  helpfulVotes      Int                  @default(0)
  isFakeFlagged     Boolean              @default(false)
  sentimentScore    Float                @default(1.0)
  createdAt         DateTime             @default(now())
}

model ChatMessage {
  id                String               @id @default(uuid())
  senderId          String
  sender            User                 @relation("SentMessages", fields: [senderId], references: [id])
  receiverId        String
  receiver          User                 @relation("ReceivedMessages", fields: [receiverId], references: [id])
  
  content           String
  mediaUrl          String?
  mediaType         String?              // TEXT, IMAGE, VOICE_NOTE, LOCATION
  isRead            Boolean              @default(false)
  encrypted         Boolean              @default(true)
  createdAt         DateTime             @default(now())

  @@index([senderId, receiverId])
}

model PanicAlert {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude          Float
  longitude         Float
  address           String
  resolved          Boolean              @default(false)
  resolvedAt        DateTime?
  createdAt         DateTime             @default(now())
}

model EmergencyContact {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactName       String
  relationship      String
  phone             String
  email             String?
  createdAt         DateTime             @default(now())
}

model IncidentReport {
  id                String               @id @default(uuid())
  reporterId        String
  reporter          User                 @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId    String
  reportedUser      User                 @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reason            String
  details           String
  status            String               @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, DISMISSED
  createdAt         DateTime             @default(now())
}

model AuditLog {
  id                String               @id @default(uuid())
  userId            String?
  user              User?                @relation(fields: [userId], references: [id])
  action            String
  ipAddress         String?
  userAgent         String?
  payload           Json?
  createdAt         DateTime             @default(now())
}

model UserSession {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String               @unique
  device            String
  ipAddress         String
  lastActive        DateTime             @default(now())
  expiresAt         DateTime
  createdAt         DateTime             @default(now())
}

enum NotificationCategory {
  SYSTEM
  BOOKING
  SAFETY
  PAYMENT
  KYC
  PROMO
  SECURITY
  COMMUNITY
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  QUEUED
}

model NotificationTemplate {
  id          String               @id @default(uuid())
  code        String               @unique // e.g. BOOKING_CONFIRMED, SOS_ALERT
  title       String
  body        String               // Supports handlebars e.g. Hi {{name}}
  category    NotificationCategory @default(SYSTEM)
  priority    NotificationPriority @default(MEDIUM)
  channels    NotificationChannel[]
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model NotificationItem {
  id          String               @id @default(uuid())
  userId      String
  title       String
  body        String
  category    NotificationCategory @default(SYSTEM)
  priority    NotificationPriority @default(MEDIUM)
  channels    NotificationChannel[]
  isRead      Boolean              @default(false)
  isArchived  Boolean              @default(false)
  isPinned    Boolean              @default(false)
  actionUrl   String?
  actionLabel String?
  metadata    Json?
  sentAt      DateTime             @default(now())
  readAt      DateTime?

  @@index([userId, isRead, category])
}

model NotificationPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  inAppEnabled      Boolean  @default(true)
  emailEnabled      Boolean  @default(true)
  pushEnabled       Boolean  @default(true)
  smsEnabled        Boolean  @default(false)
  quietHoursStart   String?  // e.g. "22:00"
  quietHoursEnd     String?  // e.g. "07:00"
  dndEnabled        Boolean  @default(false)
  disabledCategories NotificationCategory[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model NotificationLog {
  id             String              @id @default(uuid())
  notificationId String?
  userId         String
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  errorMessage   String?
  providerRef    String?             // e.g. Sendgrid MessageID, Twilio SID
  sentAt         DateTime            @default(now())

  @@index([userId, channel, status])
}

enum StaffDepartment {
  EXECUTIVE
  OPERATIONS
  TRUST_AND_SAFETY
  FINANCE_AND_ESCROW
  VERIFICATION_KYC
  CUSTOMER_SUPPORT
  ENGINEERING
  LEGAL_AND_COMPLIANCE
}

enum StaffShiftStatus {
  ON_DUTY
  OFF_DUTY
  ON_CALL
  ON_LEAVE
}

model StaffMember {
  id                String           @id @default(uuid())
  employeeId        String           @unique // e.g. EMP-2026-004
  userId            String           @unique
  fullName          String
  email             String           @unique
  phone             String?
  avatar            String?
  department        StaffDepartment  @default(OPERATIONS)
  designation       String           // e.g. Lead Dispute Arbitrator
  assignedRole      RoleType         @default(MODERATOR)
  customPermissions String[]         // Permission keys override
  shiftStatus       StaffShiftStatus @default(ON_DUTY)
  is2FAEnforced     Boolean          @default(true)
  mfaEnabled        Boolean          @default(false)
  lastLoginAt       DateTime?
  lastLoginIp       String?
  status            String           @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([department, assignedRole, status])
}

model RoleDefinition {
  id          String   @id @default(uuid())
  role        RoleType @unique
  title       String
  description String
  permissions String[] // Array of permission keys
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StaffPermission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. users:read, bookings:cancel, escrow:release
  name        String
  domain      String   // USERS, BOOKINGS, PAYMENTS, SAFETY, REVIEWS, NOTIFICATIONS, STAFF, SYSTEM
  description String
  createdAt   DateTime @default(now())
}

model StaffAccessLog {
  id           String   @id @default(uuid())
  staffId      String
  staffName    String
  staffEmail   String
  action       String   // e.g. USER_SUSPENDED, ESCROW_RELEASED, PERMISSION_MODIFIED
  resource     String   // e.g. User#usr-901, Booking#CC-2026-8812
  ipAddress    String
  userAgent    String?
  riskLevel    RiskLevel @default(LOW)
  isAuthorized Boolean  @default(true)
  details      Json?
  timestamp    DateTime @default(now())

  @@index([staffId, riskLevel, timestamp])
}

enum TwoFactorMethod {
  TOTP_AUTHENTICATOR
  SMS_OTP
  EMAIL_MAGIC_CODE
  HARDWARE_KEY
}

enum ThreatCategory {
  BRUTE_FORCE
  SQL_INJECTION
  RATE_LIMIT_BREACH
  GEO_MISMATCH
  COMPROMISED_TOKEN
  SUSPICIOUS_IP
}

model TwoFactorAuth {
  id           String          @id @default(uuid())
  userId       String          @unique
  method       TwoFactorMethod @default(TOTP_AUTHENTICATOR)
  totpSecret   String?
  backupCodes  String[]        // Array of hashed backup codes
  isVerified   Boolean         @default(false)
  isEnforced   Boolean         @default(false)
  lastUsedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model SecurityPolicy {
  id                     String   @id @default(uuid())
  policyName             String   @default("DEFAULT_ENTERPRISE_POLICY")
  whitelistedIpRanges    String[] // e.g. ["192.168.1.0/24", "10.0.0.0/16"]
  blacklistedIps         String[] // e.g. ["185.220.101.4", "45.154.255.8"]
  allowedCountries       String[] // Country codes e.g. ["US", "IN", "CA", "GB"]
  maxFailedLogins        Int      @default(5)
  sessionTimeoutMinutes  Int      @default(30)
  passwordExpiryDays     Int      @default(90)
  requireSpecialChars    Boolean  @default(true)
  isEmergencyLockdown    Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model SecurityThreat {
  id             String         @id @default(uuid())
  ipAddress      String
  category       ThreatCategory @default(BRUTE_FORCE)
  targetResource String?        // e.g. /api/auth/login
  details        String?
  riskLevel      RiskLevel      @default(HIGH)
  isBlocked      Boolean        @default(true)
  detectedAt     DateTime       @default(now())

  @@index([ipAddress, category, riskLevel])
}

model TrustedDeviceSession {
  id                String   @id @default(uuid())
  userId            String
  deviceFingerprint String
  browserName       String
  ipAddress         String
  country           String   @default("US")
  city              String?
  isTrusted         Boolean  @default(true)
  lastActiveAt      DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([userId, deviceFingerprint])
}



