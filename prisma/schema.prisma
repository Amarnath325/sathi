datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  GUEST
  CUSTOMER
  VERIFIED_COMPANION
  ADMIN
  SUPER_ADMIN
  MODERATOR
  SUPPORT_TEAM
  VERIFICATION_TEAM
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum DocumentType {
  GOVERNMENT_ID
  PASSPORT
  DRIVING_LICENSE
  SELFIE_LIVE
  ADDRESS_PROOF
  BANK_VERIFICATION
  POLICE_CLEARANCE
}

enum BookingStatus {
  PENDING_APPROVAL
  ACCEPTED
  REJECTED
  ESCROW_LOCKED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentMethod {
  STRIPE
  RAZORPAY
  WALLET
  UPI
  CREDIT_CARD
}

enum EscrowStatus {
  HELD
  RELEASED_TO_COMPANION
  REFUNDED_TO_USER
  PARTIAL_REFUND
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                String               @id @default(uuid())
  email             String               @unique
  phone             String?              @unique
  passwordHash      String
  fullName          String
  role              RoleType             @default(CUSTOMER)
  isEmailVerified   Boolean              @default(false)
  isPhoneVerified   Boolean              @default(false)
  is2FAEnabled      Boolean              @default(false)
  twoFASecret       String?
  avatar            String?
  accountFrozen     Boolean              @default(false)
  riskScore         Float                @default(0.0)
  riskLevel         RiskLevel            @default(LOW)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // Relationships
  profile           CompanionProfile?
  kycDocuments      VerificationDocument[]
  bookingsAsUser    Booking[]            @relation("UserBookings")
  bookingsAsCompanion Booking[]          @relation("CompanionBookings")
  wallet            Wallet?
  reviewsWritten    Review[]             @relation("ReviewAuthor")
  reviewsReceived   Review[]             @relation("ReviewTarget")
  sentMessages      ChatMessage[]        @relation("SentMessages")
  receivedMessages  ChatMessage[]        @relation("ReceivedMessages")
  emergencyContacts EmergencyContact[]
  sosAlerts         PanicAlert[]
  reportsFiled      IncidentReport[]     @relation("Reporter")
  reportsAgainst    IncidentReport[]     @relation("ReportedUser")
  auditLogs         AuditLog[]
  sessions          UserSession[]

  @@index([email, phone])
}

model CompanionProfile {
  id                String               @id @default(uuid())
  userId            String               @unique
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bio               String
  age               Int
  gender            String
  city              String
  country           String
  latitude          Float?
  longitude         Float?
  
  languages         String[]
  skills            String[]
  categories        String[]             // e.g. Event Companion, Shopping, Travel, Study, Elderly Support
  photos            String[]
  
  hourlyRate        Float
  dailyRate         Float?
  weeklyRate        Float?
  monthlyRate       Float?
  
  availability      Json                 // Time slot JSON matrix
  isAvailableNow    Boolean              @default(true)
  verificationBadge Boolean              @default(false)
  
  ratingAvg         Float                @default(5.0)
  ratingCount       Int                  @default(0)
  completedBookings Int                  @default(0)
  responseTimeMin   Int                  @default(15)
  
  education         String?
  experienceYears   Int                  @default(1)
  
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([city, ratingAvg])
}

model VerificationDocument {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              DocumentType
  documentUrl       String
  selfieMatchScore  Float?
  status            VerificationStatus   @default(PENDING)
  rejectionReason   String?
  verifiedByUserId  String?
  expiresAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId, status])
}

model Booking {
  id                String               @id @default(uuid())
  bookingNumber     String               @unique @default(cuid())
  userId            String
  user              User                 @relation("UserBookings", fields: [userId], references: [id])
  companionId       String
  companion         User                 @relation("CompanionBookings", fields: [companionId], references: [id])
  
  category          String
  startTime         DateTime
  endTime           DateTime
  durationHours     Float
  locationAddress   String
  specialNotes      String?
  
  hourlyRate        Float
  baseAmount        Float
  escrowFee         Float
  platformFee       Float
  totalAmount       Float
  
  status            BookingStatus        @default(PENDING_APPROVAL)
  isInstantBooking  Boolean              @default(false)
  
  payment           Payment?
  review            Review?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([userId, companionId, status])
}

model Wallet {
  id                String               @id @default(uuid())
  userId            String               @unique
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance           Float                @default(0.0)
  escrowBalance     Float                @default(0.0)
  currency          String               @default("USD")
  transactions      Transaction[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model Transaction {
  id                String               @id @default(uuid())
  walletId          String
  wallet            Wallet               @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount            Float
  type              String               // DEPOSIT, WITHDRAWAL, ESCROW_HOLD, ESCROW_RELEASE, REFUND
  referenceId       String?
  description       String
  status            String               @default("SUCCESS")
  createdAt         DateTime             @default(now())
}

model Payment {
  id                String               @id @default(uuid())
  bookingId         String               @unique
  booking           Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider          PaymentMethod
  transactionRef    String               @unique
  amount            Float
  currency          String               @default("USD")
  escrowStatus      EscrowStatus         @default(HELD)
  payoutDate        DateTime?
  createdAt         DateTime             @default(now())
}

model Review {
  id                String               @id @default(uuid())
  bookingId         String               @unique
  booking           Booking              @relation(fields: [bookingId], references: [id])
  authorId          String
  author            User                 @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId          String
  target            User                 @relation("ReviewTarget", fields: [targetId], references: [id])
  
  rating            Int
  comment           String
  photos            String[]
  helpfulVotes      Int                  @default(0)
  isFakeFlagged     Boolean              @default(false)
  sentimentScore    Float                @default(1.0)
  createdAt         DateTime             @default(now())
}

model ChatMessage {
  id                String               @id @default(uuid())
  senderId          String
  sender            User                 @relation("SentMessages", fields: [senderId], references: [id])
  receiverId        String
  receiver          User                 @relation("ReceivedMessages", fields: [receiverId], references: [id])
  
  content           String
  mediaUrl          String?
  mediaType         String?              // TEXT, IMAGE, VOICE_NOTE, LOCATION
  isRead            Boolean              @default(false)
  encrypted         Boolean              @default(true)
  createdAt         DateTime             @default(now())

  @@index([senderId, receiverId])
}

model PanicAlert {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  latitude          Float
  longitude         Float
  address           String
  resolved          Boolean              @default(false)
  resolvedAt        DateTime?
  createdAt         DateTime             @default(now())
}

model EmergencyContact {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactName       String
  relationship      String
  phone             String
  email             String?
  createdAt         DateTime             @default(now())
}

model IncidentReport {
  id                String               @id @default(uuid())
  reporterId        String
  reporter          User                 @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId    String
  reportedUser      User                 @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reason            String
  details           String
  status            String               @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, DISMISSED
  createdAt         DateTime             @default(now())
}

model AuditLog {
  id                String               @id @default(uuid())
  userId            String?
  user              User?                @relation(fields: [userId], references: [id])
  action            String
  ipAddress         String?
  userAgent         String?
  payload           Json?
  createdAt         DateTime             @default(now())
}

model UserSession {
  id                String               @id @default(uuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String               @unique
  device            String
  ipAddress         String
  lastActive        DateTime             @default(now())
  expiresAt         DateTime
  createdAt         DateTime             @default(now())
}

enum NotificationCategory {
  SYSTEM
  BOOKING
  SAFETY
  PAYMENT
  KYC
  PROMO
  SECURITY
  COMMUNITY
}

enum NotificationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
  SMS
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  QUEUED
}

model NotificationTemplate {
  id          String               @id @default(uuid())
  code        String               @unique // e.g. BOOKING_CONFIRMED, SOS_ALERT
  title       String
  body        String               // Supports handlebars e.g. Hi {{name}}
  category    NotificationCategory @default(SYSTEM)
  priority    NotificationPriority @default(MEDIUM)
  channels    NotificationChannel[]
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model NotificationItem {
  id          String               @id @default(uuid())
  userId      String
  title       String
  body        String
  category    NotificationCategory @default(SYSTEM)
  priority    NotificationPriority @default(MEDIUM)
  channels    NotificationChannel[]
  isRead      Boolean              @default(false)
  isArchived  Boolean              @default(false)
  isPinned    Boolean              @default(false)
  actionUrl   String?
  actionLabel String?
  metadata    Json?
  sentAt      DateTime             @default(now())
  readAt      DateTime?

  @@index([userId, isRead, category])
}

model NotificationPreference {
  id                String   @id @default(uuid())
  userId            String   @unique
  inAppEnabled      Boolean  @default(true)
  emailEnabled      Boolean  @default(true)
  pushEnabled       Boolean  @default(true)
  smsEnabled        Boolean  @default(false)
  quietHoursStart   String?  // e.g. "22:00"
  quietHoursEnd     String?  // e.g. "07:00"
  dndEnabled        Boolean  @default(false)
  disabledCategories NotificationCategory[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model NotificationLog {
  id             String              @id @default(uuid())
  notificationId String?
  userId         String
  channel        NotificationChannel
  status         DeliveryStatus      @default(PENDING)
  errorMessage   String?
  providerRef    String?             // e.g. Sendgrid MessageID, Twilio SID
  sentAt         DateTime            @default(now())

  @@index([userId, channel, status])
}

enum StaffDepartment {
  EXECUTIVE
  OPERATIONS
  TRUST_AND_SAFETY
  FINANCE_AND_ESCROW
  VERIFICATION_KYC
  CUSTOMER_SUPPORT
  ENGINEERING
  LEGAL_AND_COMPLIANCE
}

enum StaffShiftStatus {
  ON_DUTY
  OFF_DUTY
  ON_CALL
  ON_LEAVE
}

model StaffMember {
  id                String           @id @default(uuid())
  employeeId        String           @unique // e.g. EMP-2026-004
  userId            String           @unique
  fullName          String
  email             String           @unique
  phone             String?
  avatar            String?
  department        StaffDepartment  @default(OPERATIONS)
  designation       String           // e.g. Lead Dispute Arbitrator
  assignedRole      RoleType         @default(MODERATOR)
  customPermissions String[]         // Permission keys override
  shiftStatus       StaffShiftStatus @default(ON_DUTY)
  is2FAEnforced     Boolean          @default(true)
  mfaEnabled        Boolean          @default(false)
  lastLoginAt       DateTime?
  lastLoginIp       String?
  status            String           @default("ACTIVE") // ACTIVE, INACTIVE, SUSPENDED
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([department, assignedRole, status])
}

model RoleDefinition {
  id          String   @id @default(uuid())
  role        RoleType @unique
  title       String
  description String
  permissions String[] // Array of permission keys
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StaffPermission {
  id          String   @id @default(uuid())
  key         String   @unique // e.g. users:read, bookings:cancel, escrow:release
  name        String
  domain      String   // USERS, BOOKINGS, PAYMENTS, SAFETY, REVIEWS, NOTIFICATIONS, STAFF, SYSTEM
  description String
  createdAt   DateTime @default(now())
}

model StaffAccessLog {
  id           String   @id @default(uuid())
  staffId      String
  staffName    String
  staffEmail   String
  action       String   // e.g. USER_SUSPENDED, ESCROW_RELEASED, PERMISSION_MODIFIED
  resource     String   // e.g. User#usr-901, Booking#CC-2026-8812
  ipAddress    String
  userAgent    String?
  riskLevel    RiskLevel @default(LOW)
  isAuthorized Boolean  @default(true)
  details      Json?
  timestamp    DateTime @default(now())

  @@index([staffId, riskLevel, timestamp])
}

enum TwoFactorMethod {
  TOTP_AUTHENTICATOR
  SMS_OTP
  EMAIL_MAGIC_CODE
  HARDWARE_KEY
}

enum ThreatCategory {
  BRUTE_FORCE
  SQL_INJECTION
  RATE_LIMIT_BREACH
  GEO_MISMATCH
  COMPROMISED_TOKEN
  SUSPICIOUS_IP
}

model TwoFactorAuth {
  id           String          @id @default(uuid())
  userId       String          @unique
  method       TwoFactorMethod @default(TOTP_AUTHENTICATOR)
  totpSecret   String?
  backupCodes  String[]        // Array of hashed backup codes
  isVerified   Boolean         @default(false)
  isEnforced   Boolean         @default(false)
  lastUsedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model SecurityPolicy {
  id                     String   @id @default(uuid())
  policyName             String   @default("DEFAULT_ENTERPRISE_POLICY")
  whitelistedIpRanges    String[] // e.g. ["192.168.1.0/24", "10.0.0.0/16"]
  blacklistedIps         String[] // e.g. ["185.220.101.4", "45.154.255.8"]
  allowedCountries       String[] // Country codes e.g. ["US", "IN", "CA", "GB"]
  maxFailedLogins        Int      @default(5)
  sessionTimeoutMinutes  Int      @default(30)
  passwordExpiryDays     Int      @default(90)
  requireSpecialChars    Boolean  @default(true)
  isEmergencyLockdown    Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model SecurityThreat {
  id             String         @id @default(uuid())
  ipAddress      String
  category       ThreatCategory @default(BRUTE_FORCE)
  targetResource String?        // e.g. /api/auth/login
  details        String?
  riskLevel      RiskLevel      @default(HIGH)
  isBlocked      Boolean        @default(true)
  detectedAt     DateTime       @default(now())

  @@index([ipAddress, category, riskLevel])
}

model TrustedDeviceSession {
  id                String   @id @default(uuid())
  userId            String
  deviceFingerprint String
  browserName       String
  ipAddress         String
  country           String   @default("US")
  city              String?
  isTrusted         Boolean  @default(true)
  lastActiveAt      DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([userId, deviceFingerprint])
}

enum AuditAction {
  CREATE
  READ
  UPDATE
  DELETE
  EXECUTE
  AUTHENTICATE
  AUTHORIZE_OVERRIDE
  EXPORT
}

enum AuditChecksumStatus {
  VALID
  CORRUPTED
  TAMPERED
}

enum AuditDomain {
  FINANCE_AND_ESCROW
  TRUST_AND_SAFETY
  STAFF_RBAC
  SYSTEM_CONFIG
  USERS
  BOOKINGS
  REVIEWS
  KYC_VERIFICATION
}

model AuditTrailLog {
  id             String              @id @default(uuid())
  sequenceNumber Int                 @default(autoincrement())
  previousHash   String              // SHA-256 hash of previous entry
  currentHash    String              // SHA-256 checksum of this entry
  actorId        String
  actorName      String
  actorEmail     String
  actorRole      RoleType            @default(ADMIN)
  action         AuditAction         @default(UPDATE)
  resourceDomain AuditDomain         @default(SYSTEM_CONFIG)
  resourceId     String              // e.g. EscrowPayout#9901, User#usr-102
  payload        Json?               // Details diff or payload
  ipAddress      String
  userAgent      String?
  checksumStatus AuditChecksumStatus @default(VALID)
  timestamp      DateTime            @default(now())

  @@index([sequenceNumber, resourceDomain, checksumStatus])
}

model AuditRetentionPolicy {
  id                  String      @id @default(uuid())
  domain              AuditDomain @unique
  retentionDays       Int         @default(2555) // 7 years default for finance
  autoArchive         Boolean     @default(true)
  coldStorageEnabled  Boolean     @default(true)
  complianceStandard  String      @default("SOC2_TYPE_II") // SOC2, HIPAA, GDPR, PCI_DSS
  updatedAt           DateTime    @updatedAt
}

model AuditExportJob {
  id             String   @id @default(uuid())
  requestedBy    String
  domainFilter   String   @default("ALL")
  startDate      DateTime
  endDate        DateTime
  format         String   @default("CRYPTOGRAPHIC_PROOF") // CSV, JSON, PDF_REPORT, CRYPTOGRAPHIC_PROOF
  fileUrl        String?
  status         String   @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED
  createdAt      DateTime @default(now())
}

enum SettingCategory {
  GENERAL
  FINANCE
  COMMUNICATION
  STORAGE
  MAINTENANCE
  SECURITY
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  ENCRYPTED_SECRET
}

model SystemSetting {
  id          String           @id @default(uuid())
  key         String           @unique // e.g. platform.name, escrow.commission_rate
  category    SettingCategory  @default(GENERAL)
  value       String           // Serialized string / JSON value
  valueType   SettingValueType @default(STRING)
  isEncrypted Boolean          @default(false)
  isPublic    Boolean          @default(false)
  description String?
  updatedBy   String?
  updatedAt   DateTime         @updatedAt

  @@index([category, key])
}

model SystemMaintenanceSchedule {
  id               String   @id @default(uuid())
  title            String
  description      String?
  startTime        DateTime
  endTime          DateTime
  isLiveBanner     Boolean  @default(false)
  affectedServices String[] // e.g. ["PAYMENTS_API", "COMPANION_SEARCH"]
  createdBy        String
  createdAt        DateTime @default(now())
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  DOWN
}

enum HealthAlertType {
  CPU_SPIKE
  MEMORY_EXHAUSTION
  DB_POOL_EXHAUSTION
  HIGH_LATENCY
  SERVICE_DOWN
}

model SystemHealthMetric {
  id                 String   @id @default(uuid())
  nodeName           String   @default("sathi-prod-uswest2-node-01")
  cpuUsagePercent    Float    @default(34.2)
  memoryUsagePercent Float    @default(58.7)
  diskUsagePercent   Float    @default(41.0)
  dbPoolActive       Int      @default(14)
  dbPoolIdle         Int      @default(36)
  redisHitRatePercent Float   @default(99.4)
  activeWebsockets   Int      @default(1420)
  responseLatencyMs  Int      @default(38)
  timestamp          DateTime @default(now())

  @@index([nodeName, timestamp])
}

model MicroserviceStatus {
  id            String       @id @default(uuid())
  serviceName   String       @unique // e.g. DATABASE_POSTGRES, REDIS_CACHE, PAYMENT_STRIPE
  endpointUrl   String
  status        HealthStatus @default(HEALTHY)
  uptimePercent Float        @default(99.98)
  lastPingMs    Int          @default(12)
  lastCheckedAt DateTime     @default(now())
}

model SystemHealthAlert {
  id          String          @id @default(uuid())
  serviceName String
  alertType   HealthAlertType @default(CPU_SPIKE)
  severity    RiskLevel       @default(HIGH)
  message     String
  isResolved  Boolean         @default(false)
  triggeredAt DateTime        @default(now())
  resolvedAt  DateTime?

  @@index([serviceName, isResolved, severity])
}

enum CommChannel {
  SMS
  EMAIL
  PUSH
  IN_APP_BANNER
}

enum CommAudience {
  ALL_USERS
  VERIFIED_COMPANIONS
  PREMIUM_CLIENTS
  STAFF_ONLY
}

enum CommCampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  FAILED
}

enum CommTemplateCategory {
  TRANSACTIONAL
  MARKETING
  SECURITY
  SYSTEM
}

enum CommDeliveryStatus {
  QUEUED
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  FAILED
}

model CommunicationCampaign {
  id              String             @id @default(uuid())
  title           String
  channel         CommChannel        @default(EMAIL)
  targetAudience  CommAudience       @default(ALL_USERS)
  subject         String?
  body            String
  status          CommCampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int                @default(0)
  successCount    Int                @default(0)
  failedCount     Int                @default(0)
  createdBy       String
  createdAt       DateTime           @default(now())

  deliveryLogs CommunicationDeliveryLog[]
}

model CommunicationTemplate {
  id               String               @id @default(uuid())
  templateKey      String               @unique // e.g. booking_confirmation, kyc_approved
  channel          CommChannel          @default(EMAIL)
  name             String
  subject          String?
  bodyTemplate     String
  variables        String[]             // e.g. ["user_name", "booking_id", "escrow_amount"]
  category         CommTemplateCategory @default(TRANSACTIONAL)
  isSystemTemplate Boolean              @default(false)
  updatedAt        DateTime             @updatedAt
}

model CommunicationDeliveryLog {
  id                String             @id @default(uuid())
  campaignId        String
  recipientEmail    String?
  recipientPhone    String?
  channel           CommChannel
  status            CommDeliveryStatus @default(QUEUED)
  providerMessageId String?
  errorMessage      String?
  deliveredAt       DateTime           @default(now())

  campaign CommunicationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
}

enum ExecutiveAlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum ExecutiveAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ExecutiveReportType {
  WEEKLY_BOARD_DECK
  MONTHLY_FINANCIAL_AUDIT
  SECURITY_COMPLIANCE_SUMMARY
  QUARTERLY_TAX_RESERVE
}

model ExecutiveKPISnapshot {
  id                  String   @id @default(uuid())
  snapshotDate        DateTime @default(now())
  timeframe           String   @default("30D")
  region              String   @default("ALL")
  gmvAmount           Float
  netRevenue          Float
  escrowReserve       Float
  activeCompanions    Int
  companionRetention  Float
  systemSecurityScore Int
  clvToCacRatio       Float
  createdAt           DateTime @default(now())

  @@index([snapshotDate, timeframe])
}

model ExecutiveAlert {
  id          String                 @id @default(uuid())
  title       String
  category    String
  description String
  severity    ExecutiveAlertSeverity @default(WARNING)
  status      ExecutiveAlertStatus   @default(OPEN)
  metadata    String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([status, severity])
}

model ExecutiveReport {
  id            String              @id @default(uuid())
  title         String
  reportType    ExecutiveReportType @default(WEEKLY_BOARD_DECK)
  fileFormat    String              @default("PDF")
  downloadUrl   String
  generatedBy   String
  periodCovered String
  createdAt     DateTime            @default(now())
}

enum AnalyticsDomain {
  OVERVIEW
  FINANCIAL
  USER_GROWTH
  OPERATIONS
  SAFETY
}

enum ReportRecurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
}

model AnalyticsDailySnapshot {
  id                String   @id @default(uuid())
  snapshotDate      DateTime @default(now())
  gmvAmount         Float
  netRevenue        Float
  escrowVolume      Float
  activeUsers       Int
  newCompanions     Int
  totalBookings     Int
  completedBookings Int
  cancelledBookings Int
  safetyIncidents   Int
  avgRating         Float
  createdAt         DateTime @default(now())

  @@index([snapshotDate])
}

model SavedReportTemplate {
  id           String           @id @default(uuid())
  title        String
  domain       AnalyticsDomain  @default(OVERVIEW)
  metrics      String[]
  groupBy      String           @default("DATE")
  timeframe    String           @default("30D")
  recurrence   ReportRecurrence @default(NONE)
  outputFormat String           @default("PDF")
  createdBy    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model AnalyticsExportLog {
  id          String   @id @default(uuid())
  reportTitle String
  format      String
  recordCount Int
  downloadUrl String
  exportedBy  String
  createdAt   DateTime @default(now())
}









